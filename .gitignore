# Track only the personal customisations; everything else is Herdr's or written by it.
/*
!/.gitignore
!/settings.json
!/layouts/
/layouts/*
!/layouts/my-layout.json
!/mods/
/mods/*
!/mods/my-files/
!/mods/my-tabs/
!/mods/my-agents/
!/mods/md-viewer/
!/mods/history/
# Regenerated by Herdr inside each mod folder
*.d.ts
jsconfig.json
*.error
